{
  "name": "opencode-ci",
  "version": "0.1.14",
  "description": "OpenCode V2 CI runner with subagent output and command/skill support",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opencode-ci": "dist/cli.js"
  },
  "files": ["dist", "docs", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbpolito/opencode-ci.git"
  },
  "homepage": "https://github.com/dbpolito/opencode-ci#readme",
  "bugs": "https://github.com/dbpolito/opencode-ci/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun build ./src/cli.ts --target node --external @opencode/sdk --external commander --outdir dist",
    "smoke:node": "bun run build && node script/smoke-node.mjs",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@opencode/sdk": "2.0.16",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
